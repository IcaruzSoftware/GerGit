<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GerGit.ViewModels"
             xmlns:v="using:GerGit.Views"
             xmlns:c="using:GerGit.Controls"
             x:Class="GerGit.Views.SidebarView"
             x:DataType="vm:SidebarViewModel"
             Background="{DynamicResource Color.Sidebar.Bg}">
  <UserControl.Styles>
    <!-- Local Changes / All Commits rows -->
    <Style Selector="RadioButton.viewrow">
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="bd" Background="Transparent" CornerRadius="4" Padding="20,2">
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.viewrow:checked /template/ Border#bd">
      <Setter Property="Background" Value="{DynamicResource Color.Sidebar.SelectedBg}" />
    </Style>

    <!-- Mode toggles: 40 x 24, icon 16, checked = accent -->
    <Style Selector="ToggleButton.mode">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource Color.Icon.Default}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="bd" Background="Transparent" CornerRadius="3">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.mode:pointerover /template/ Border#bd">
      <Setter Property="Background" Value="{DynamicResource Color.Btn.BgHover}" />
    </Style>
    <Style Selector="ToggleButton.mode:checked">
      <Setter Property="Foreground" Value="{DynamicResource Color.Accent.Base}" />
    </Style>
    <Style Selector="ToggleButton.mode:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- Tree rows -->
    <Style Selector="TreeView.sidebar TreeViewItem" x:DataType="vm:SidebarNode">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <!-- "Show all" rows: not focusable, so the keyboard passes them by -->
      <Setter Property="Focusable" Value="{Binding !IsShowAll}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel>
            <Border Name="PART_LayoutRoot" Height="22" Margin="2,0" Padding="2,0" CornerRadius="4" Background="Transparent">
              <Grid Name="PART_Header" ColumnDefinitions="16,*"
                    Margin="{TemplateBinding Level, Converter={x:Static v:SidebarView.IndentConverter}}">
                <ToggleButton Name="PART_ExpandCollapseChevron" Classes="expander" Focusable="False"
                              IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                              IsVisible="{Binding HasChildren}" />
                <ContentPresenter Name="PART_HeaderPresenter" Grid.Column="1" Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ItemsPresenter Name="PART_ItemsPresenter" IsVisible="{TemplateBinding IsExpanded}"
                            ItemsPanel="{TemplateBinding ItemsPanel}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TreeView.sidebar TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource Color.TreeRow.BgSelectedInactive}" />
    </Style>
    <Style Selector="TreeView.sidebar:focus-within TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource Color.TreeRow.BgSelected}" />
    </Style>
    <Style Selector="TreeView.sidebar:focus-within TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.expander">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <c:LucideIcon Name="chevron" Icon="chevron-right" Size="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Foreground="{DynamicResource Color.Glyph.Default}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.expander:checked /template/ c|LucideIcon#chevron">
      <Setter Property="Icon" Value="chevron-down" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.bold">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.link">
      <Setter Property="Foreground" Value="{DynamicResource Color.Text.Muted}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Header row: repository name and the settings button -->
    <Grid DockPanel.Dock="Top" Height="22" Margin="20,2,2,2" ColumnDefinitions="*,Auto">
      <TextBlock Text="{Binding Tab.Title}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Tab.HeaderToolTip}" />
      <Button Name="SettingsButton" Grid.Column="1" Classes="icon" Width="16" Height="16" VerticalAlignment="Center" ToolTip.Tip="Repository Settings">
        <c:LucideIcon Icon="settings" Size="14" />
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuItem Header="Rename Repository" IsEnabled="False" />
            <MenuItem Header="Copy Repository Path" Click="OnCopyPathClick" />
            <Separator />
            <MenuItem Header="Settings for This Repository..." Click="OnSettingsClick" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <RadioButton DockPanel.Dock="Top" Classes="viewrow" IsChecked="{Binding Tab.IsLocalChangesView}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <c:LucideIcon Icon="file-pen" Size="16" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Tab.LocalChangesText}" VerticalAlignment="Center" />
      </StackPanel>
    </RadioButton>
    <RadioButton DockPanel.Dock="Top" Classes="viewrow" IsChecked="{Binding Tab.IsAllCommitsView}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <c:LucideIcon Icon="git-commit-horizontal" Size="16" VerticalAlignment="Center" />
        <TextBlock Text="All Commits" VerticalAlignment="Center" />
      </StackPanel>
    </RadioButton>

    <!-- Mode toggles. Search is not built yet; Pull Requests is hidden until hosting accounts exist. -->
    <Border DockPanel.Dock="Top" Margin="0,5,0,0" BorderThickness="0,1" BorderBrush="{DynamicResource Color.Border.Default}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <ToggleButton Classes="mode" IsChecked="True" IsHitTestVisible="False" ToolTip.Tip="Branches">
          <c:LucideIcon Icon="git-branch" Size="16" />
        </ToggleButton>
        <ToggleButton Classes="mode" IsEnabled="False" ToolTip.Tip="Search Commits">
          <c:LucideIcon Icon="search" Size="16" />
        </ToggleButton>
      </StackPanel>
    </Border>

    <TextBox Name="Filter" DockPanel.Dock="Top" Classes="filter" Margin="4" PlaceholderText="Filter"
             Text="{Binding FilterText}" KeyDown="OnFilterKeyDown">
      <TextBox.InnerLeftContent>
        <c:LucideIcon Icon="search" Size="14" Margin="4,0,2,0" VerticalAlignment="Center" Foreground="{DynamicResource Color.Glyph.Default}" />
      </TextBox.InnerLeftContent>
      <TextBox.InnerRightContent>
        <Button Classes="icon" Width="16" Height="16" Margin="0,0,2,0" Command="{Binding ClearFilterCommand}"
                IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <c:LucideIcon Icon="x" Size="12" />
        </Button>
      </TextBox.InnerRightContent>
    </TextBox>

    <TreeView Name="Tree" Classes="sidebar" FontSize="13" ItemsSource="{Binding Roots}" SelectionMode="Multiple"
              SelectedItems="{Binding SelectedNodes}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="OnTreeKeyDown">
      <TreeView.ItemTemplate>
        <TreeDataTemplate DataType="vm:SidebarNode" ItemsSource="{Binding Children}">
          <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
            <Panel Width="16" Height="16" Margin="0,0,4,0" Opacity="{Binding IconOpacity}"
                   IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}">
              <c:LucideIcon Icon="{Binding Icon}" Size="16" IsVisible="{Binding !IsRemote}" />
              <c:HostIcon Type="{Binding HostType}" Size="16" IsVisible="{Binding IsRemote}" />
              <c:LucideIcon Icon="triangle-alert" Size="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Foreground="{DynamicResource Color.Status.Warning}" IsVisible="{Binding HasWarning}" />
            </Panel>
            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Classes.section="{Binding IsSection}" Classes.bold="{Binding IsBold}" Classes.link="{Binding IsShowAll}"
                       c:TrimmedToolTip.IsEnabled="{Binding ToolTip, Converter={x:Static ObjectConverters.IsNull}}" />
            <TextBlock Grid.Column="2" Text="{Binding AheadBehind}" Margin="4,0,2,0" VerticalAlignment="Center"
                       IsVisible="{Binding AheadBehind, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </Grid>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
