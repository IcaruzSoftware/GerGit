<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GerGit.ViewModels.Preferences"
             xmlns:gvm="using:GerGit.ViewModels"
             xmlns:c="using:GerGit.Controls"
             x:Class="GerGit.Views.Preferences.ExternalToolsEditorView"
             x:DataType="vm:ExternalToolsEditorViewModel">
  <!-- list column 160 px (list 85 px + 17 px footer bar), then the detail panel. -->
  <UserControl.Styles>
    <Style Selector="ListBox#ToolList > ListBoxItem">
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="TextBlock.primary">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Color.Text.Secondary}" />
    </Style>
    <!-- As in LocalChangesView: inactive selection keeps the text colour; white only on the focused blue. -->
    <Style Selector="ListBox#ToolList > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Color.Row.BgSelectedInactive}" />
    </Style>
    <Style Selector="ListBox#ToolList:focus-within > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Color.Row.BgSelected}" />
      <Setter Property="Foreground" Value="{DynamicResource Color.Text.OnAccent}" />
    </Style>
    <Style Selector="ListBox#ToolList:focus-within > ListBoxItem:selected TextBlock.primary">
      <Setter Property="Foreground" Value="{DynamicResource Color.Text.OnAccent}" />
    </Style>
    <Style Selector="Grid#Detail > TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="160,*" ColumnSpacing="10" Margin="10,0,0,0">
    <DockPanel Height="102">
      <Border DockPanel.Dock="Bottom" Height="17" BorderThickness="1,0,1,1" BorderBrush="{DynamicResource Color.List.Border}"
              Background="{DynamicResource Color.Surface.Base}">
        <StackPanel Orientation="Horizontal">
          <Button Name="AddToolButton" Classes="icon" Width="18" Height="17" ToolTip.Tip="Add" Click="OnAdd">
            <c:LucideIcon Icon="plus" Size="12" />
          </Button>
          <Button Name="RemoveToolButton" Classes="icon" Width="18" Height="17" ToolTip.Tip="Remove"
                  IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}" Click="OnRemove">
            <c:LucideIcon Icon="minus" Size="12" />
          </Button>
        </StackPanel>
      </Border>
      <ListBox Name="ToolList" ItemsSource="{Binding Tools}" SelectedItem="{Binding Selected}" ContextRequested="OnRowMenu"
               BorderThickness="1" BorderBrush="{DynamicResource Color.List.Border}" Background="{DynamicResource Color.List.Bg}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="gvm:ExternalTool">
            <Grid ColumnDefinitions="16,*,Auto" Height="18" Background="Transparent">
              <c:LucideIcon Size="14" IsVisible="{Binding IsAvailable}" Foreground="{DynamicResource Color.Icon.Default}"
                            Icon="{Binding $parent[UserControl].((vm:ExternalToolsEditorViewModel)DataContext).Icon}" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Margin="6,1,2,1" TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="primary" Text="primary" IsVisible="{Binding IsPrimary}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Empty list: the empty-state panel instead of the details. -->
    <Border Grid.Column="1" Height="102" CornerRadius="4" Background="{DynamicResource Color.Surface.Group}" IsVisible="{Binding !HasTools}">
      <c:LucideIcon Icon="git-compare" Size="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Foreground="{DynamicResource Color.Icon.Default}" />
    </Border>
    <Border Grid.Column="1" Height="102" CornerRadius="4" Padding="8" Background="{DynamicResource Color.Surface.Group}"
            IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid Name="Detail" ColumnDefinitions="68,*,Auto" RowDefinitions="*,*,*" ColumnSpacing="4">
        <TextBlock Text="Name:" />
        <TextBox Name="ToolName" Grid.Column="1" Width="195" HorizontalAlignment="Left" PlaceholderText="External tool name"
                 Text="{Binding Selected.Name}" IsVisible="{Binding Selected.IsCustom, FallbackValue=False}" />
        <TextBlock Grid.Column="1" Text="{Binding Selected.Name}" IsVisible="{Binding Selected.IsPredefined, FallbackValue=False}" />
        <TextBlock Grid.Row="1" Text="Path:" />
        <TextBox Name="ToolPath" Grid.Row="1" Grid.Column="1" IsReadOnly="True" PlaceholderText="External tool location"
                 Text="{Binding Selected.ShownPath, Mode=OneWay}" />
        <Button Name="BrowseTool" Grid.Row="1" Grid.Column="2" Classes="icon" Width="24" Height="24" ToolTip.Tip="Browse..."
                Click="OnBrowse">
          <c:LucideIcon Icon="folder-open" Size="14" />
        </Button>
        <TextBlock Grid.Row="2" Text="Arguments:" />
        <TextBox Name="ToolArgs" Grid.Row="2" Grid.Column="1" PlaceholderText="External tool arguments" Text="{Binding Selected.Args}" />
        <Border Name="ArgsHint" Grid.Row="2" Grid.Column="2" Width="24" Height="24" Background="Transparent" ToolTip.Tip="{Binding Hint}">
          <c:LucideIcon Icon="info" Size="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Foreground="{DynamicResource Color.Icon.Default}" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
