<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GerGit.ViewModels.Preferences"
             xmlns:c="using:GerGit.Controls"
             xmlns:p="using:GerGit.Views.Preferences"
             x:Class="GerGit.Views.Preferences.PreferencesView"
             x:DataType="vm:PreferencesViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://GerGit/Views/Accounts/AccountStyles.axaml" />
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <!-- settings headings 14 px medium; labels right-aligned in column 0, controls 10 px to the right. -->
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Grid.page">
      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="RowSpacing" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.page > TextBlock.label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.page > Separator">
      <Setter Property="Margin" Value="0,4,0,4" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="20" />
    </Style>
    <Style Selector="TextBox.number">
      <Setter Property="Width" Value="40" />
      <Setter Property="MinWidth" Value="40" />
    </Style>
    <Style Selector="ListBox#FolderList > ListBoxItem">
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="MinHeight" Value="18" />
    </Style>
  </UserControl.Styles>

  <TabControl Name="Pages" Padding="0">
    <!-- General (content width 500). -->
    <TabItem Header="General">
      <Grid Classes="page" Width="500" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Classes="heading" Grid.ColumnSpan="2" Text="Source Code Folder" />
        <!-- Folder list (52 px) and its footer bar (+ / −). -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="10,0,0,0">
          <Border DockPanel.Dock="Bottom" Height="20" BorderThickness="1,0,1,1" BorderBrush="{DynamicResource Color.List.Border}"
                  Background="{DynamicResource Color.Surface.Base}">
            <StackPanel Orientation="Horizontal">
              <Button Name="AddFolderButton" Classes="icon" Width="18" Height="18" ToolTip.Tip="Add New..." Click="OnAddFolder">
                <c:LucideIcon Icon="plus" Size="12" />
              </Button>
              <Button Name="RemoveFolderButton" Classes="icon" Width="18" Height="18" IsVisible="{Binding CanRemoveFolder}"
                      IsEnabled="{Binding SelectedFolder, Converter={x:Static ObjectConverters.IsNotNull}}" Click="OnRemoveFolder">
                <c:LucideIcon Icon="minus" Size="12" />
              </Button>
            </StackPanel>
          </Border>
          <ListBox Name="FolderList" Height="52" ItemsSource="{Binding SourceFolders}" SelectedItem="{Binding SelectedFolder}"
                   BorderThickness="1" BorderBrush="{DynamicResource Color.List.Border}" Background="{DynamicResource Color.List.Bg}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SourceFolderItem">
                <Grid ColumnDefinitions="16,*,18" Height="18" Background="Transparent">
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Add New..." Click="OnAddFolder" />
                      <MenuItem Header="Delete..." Click="OnRemoveFolderRow"
                                IsEnabled="{Binding CanRemove}" />
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <c:LucideIcon Icon="folder" Size="16" IsVisible="{Binding !IsWarning}" />
                  <c:LucideIcon Icon="triangle-alert" Size="16" IsVisible="{Binding IsWarning}" ToolTip.Tip="{Binding WarningTip}"
                                Foreground="{DynamicResource Color.Status.Warning}" />
                  <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="13" Margin="6,1,2,1" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="2" Classes="icon" Width="18" Height="16" ToolTip.Tip="Replace..." Click="OnReplaceFolder">
                    <c:LucideIcon Icon="folder-open" Size="12" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <Separator Grid.Row="2" Grid.ColumnSpan="2" />

        <TextBlock Classes="heading" Grid.Row="3" Grid.ColumnSpan="2" Text="Diff View" />
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="10,0,0,0">
          <TextBlock Text="Font size:" FontSize="13" VerticalAlignment="Center" />
          <TextBox Name="FontSizeBox" Classes="number" Margin="10,0,0,0" Text="{Binding FontSizeText}" />
        </StackPanel>
        <Separator Grid.Row="5" Grid.ColumnSpan="2" />

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="10,0,0,0" Spacing="8">
          <CheckBox Name="AutoFetch" Content="Fetch remotes automatically" IsChecked="{Binding AutoFetch}" />
          <CheckBox Name="FetchWithTags" Content="Always include tags into fetch" IsChecked="{Binding FetchWithTags}" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Space character in branch names:" FontSize="13" VerticalAlignment="Center" />
            <ComboBox Name="SpaceChar" Margin="10,0,0,0" MinWidth="50" ItemsSource="{Binding SpaceChars}"
                      SelectedItem="{Binding SpaceChar}" />
          </StackPanel>
          <CheckBox Name="PushAfterCommit" Content="Push automatically on commit" IsChecked="{Binding PushAfterCommit}" />
          <CheckBox Name="UpdateSubmodules" Content="Update submodules automatically after checkout, pull and merge"
                    IsChecked="{Binding UpdateSubmodules}"
                    ToolTip.Tip="Only submodules that are already initialized and checked out are updated. New submodules are never initialized or cloned." />
        </StackPanel>
      </Grid>
    </TabItem>

    <!-- Commit (content width 500). -->
    <TabItem Header="Commit">
      <Grid Classes="page" Width="500" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
        <TextBlock Classes="heading" Grid.ColumnSpan="2" Text="Commit Message" />
        <TextBlock Classes="label" Grid.Row="1" Text="Length indicator:" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
          <TextBlock Text="Low limit:" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
          <TextBox Name="LowLimit" Classes="number" Margin="10,0,0,0" Text="{Binding LowLimitText}" />
          <TextBlock Text="High limit:" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
          <TextBox Name="HighLimit" Classes="number" Margin="10,0,0,0" Text="{Binding HighLimitText}" />
        </StackPanel>
      </Grid>
    </TabItem>

    <!-- Git (content width 500). -->
    <TabItem Header="Git">
      <Grid Classes="page" Width="500" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
        <TextBlock Classes="label" Text="Git Instance:" />
        <!-- a combo with one fixed entry; shown as text because there is nothing to choose. -->
        <TextBlock Name="GitInstance" Grid.Column="1" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Text="{Binding GitInstance}" ToolTip.Tip="{Binding GitInstance}" />
        <Separator Grid.Row="1" Grid.ColumnSpan="2" />
        <TextBlock Classes="heading" Grid.Row="2" Grid.ColumnSpan="2" Text="Global User Information" />
        <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="10,0,0,0">
          <c:AvatarView Grid.RowSpan="2" Width="42" Height="42" Margin="0,0,10,0" Email="{Binding AvatarEmail}"
                        AuthorName="{Binding UserName}" />
          <TextBox Name="UserName" Grid.Column="1" PlaceholderText="{Binding UserNameHint}" Text="{Binding UserName}" LostFocus="OnIdentityLostFocus" />
          <TextBox Name="UserEmail" Grid.Column="1" Grid.Row="1" PlaceholderText="{Binding UserEmailHint}" Text="{Binding UserEmail}" LostFocus="OnIdentityLostFocus" />
        </Grid>
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="62,0,0,0">
          <TextBlock Text="Change the avatar at" FontSize="13" VerticalAlignment="Center" />
          <Button Classes="link" Margin="4,0,0,0" Content="gravatar.com" Click="OnGravatar" />
        </StackPanel>
      </Grid>
    </TabItem>

    <!-- Integration (content width 650). -->
    <TabItem Header="Integration">
      <Grid Classes="page" Width="650" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Classes="heading" Grid.ColumnSpan="3" Margin="0,0,0,6" Text="Issue Tracker Integration" />
        <CheckBox Name="IssueLinks" Grid.Row="1" Grid.ColumnSpan="3" Margin="10,0,0,0" IsChecked="{Binding IssueLinks}"
                  Content="Highlight issue tracker links in commit messages" />
        <!-- The external tool editors, between separators. -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Spacing="8">
          <Separator />
          <TextBlock Classes="heading" Text="External Merge Tools" />
          <p:ExternalToolsEditorView Name="MergeToolsEditor" DataContext="{Binding MergeTools}" />
          <Separator />
          <TextBlock Classes="heading" Text="External Diff Tools" />
          <p:ExternalToolsEditorView Name="DiffToolsEditor" DataContext="{Binding DiffTools}" />
          <Separator />
        </StackPanel>
        <TextBlock Classes="heading" Grid.Row="3" Grid.ColumnSpan="3" Text="Shell" />
        <TextBlock Classes="label" Grid.Row="4" Text="Shell:" />
        <ComboBox Name="Shell" Grid.Row="4" Grid.Column="1" MinWidth="160" ItemsSource="{Binding ShellKinds}"
                  SelectedIndex="{Binding ShellIndex}" />
        <TextBlock Classes="label" Grid.Row="5" Text="Shell Path:" />
        <TextBox Name="ShellPath" Grid.Row="5" Grid.Column="1" IsReadOnly="True" PlaceholderText="Select shell location"
                 Text="{Binding ShellPath, Mode=OneWay}" />
        <Button Name="BrowseShell" Grid.Row="5" Grid.Column="2" Classes="icon" Width="24" Height="24" ToolTip.Tip="Browse..."
                IsEnabled="{Binding ShellIsCustom}" Click="OnBrowseShell">
          <c:LucideIcon Icon="folder-open" Size="14" />
        </Button>
        <TextBlock Classes="label" Grid.Row="6" Text="Arguments:" />
        <TextBox Name="ShellArgs" Grid.Row="6" Grid.Column="1" IsEnabled="{Binding ShellIsCustom}" Text="{Binding ShellArgs}" />
        <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Spacing="8">
          <Separator />
          <TextBlock Classes="heading" Text="Avatars" />
          <CheckBox Name="LoadAvatars" Margin="10,0,0,0" IsChecked="{Binding LoadAvatars}"
                    Content="Load avatars (Gravatar, GitHub, GitLab)"
                    ToolTip.Tip="Also the pictures of your accounts and notifications. Off: no avatar is downloaded and authors show their initials." />
        </StackPanel>
      </Grid>
    </TabItem>
  </TabControl>
</UserControl>
