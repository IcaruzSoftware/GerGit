<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GerGit.ViewModels"
        xmlns:d="using:GerGit.ViewModels.Dialogs"
        xmlns:v="using:GerGit.Views"
        xmlns:c="using:GerGit.Controls"
        x:Class="GerGit.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}" Width="1000" Height="600" MinWidth="650" MinHeight="400"
        v:Zoom.Percent="{Binding ZoomPercent}">
  <!-- Layout. System decorations; the menu bar is the first row instead of a custom title bar.
       Layout zoom: this window's setting is the app-wide layout scale of every window (Views/Zoom.cs). -->
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <!-- Not built yet: "Init New Repository...". -->
        <MenuItem Header="Clone..." InputGesture="Ctrl+N" Click="OnCloneClick" />
        <Separator />
        <MenuItem Header="New Tab" InputGesture="Ctrl+T" Click="OnNewTabClick" />
        <MenuItem Header="Open Repository..." InputGesture="Ctrl+O" Click="OnOpenClick" />
        <MenuItem Header="Quick Launch..." InputGesture="Ctrl+P" Click="OnQuickLaunchClick" />
        <MenuItem Header="Close Tab" InputGesture="Ctrl+W" Command="{Binding CloseTabCommand}" CommandParameter="{x:Null}" />
        <Separator />
        <!-- Not built yet: "Configure SSH Keys...". -->
        <MenuItem Header="Accounts..." Click="OnAccountsClick" />
        <Separator />
        <MenuItem Header="Preferences..." InputGesture="Ctrl+OemComma" Click="OnPreferencesClick" />
        <Separator />
        <MenuItem Header="Exit" Click="OnExitClick" />
      </MenuItem>
      <!-- View menu, repository tabs only. Not built yet: further items, which come with their features. -->
      <MenuItem Header="_View" IsVisible="{Binding SelectedTab, Converter={x:Static ObjectConverters.IsNotNull}}">
        <MenuItem Header="Show Uncommitted Changes" InputGesture="Ctrl+1" Click="OnShowLocalChanges" />
        <MenuItem Header="Show All Commits" InputGesture="Ctrl+2" Click="OnShowAllCommits" />
      </MenuItem>
      <!-- Repository menu, repository tabs only. Not built yet: Add .gitignore… (with the .gitignore dialogs),
           Git Flow, Git LFS, Apply Patch…, Bisect and Repository Statistics / Treemap come with their features. -->
      <MenuItem Name="RepositoryMenu" Header="_Repository" IsVisible="{Binding SelectedTab, Converter={x:Static ObjectConverters.IsNotNull}}">
        <MenuItem Header="Refresh" InputGesture="F5" Tag="refresh" Click="OnCommandClick" />
        <Separator />
        <MenuItem Header="Fetch..." InputGesture="Ctrl+Shift+F" Tag="fetch" Click="OnCommandClick" />
        <MenuItem Header="Pull..." InputGesture="Ctrl+Shift+L" Tag="pull" Click="OnCommandClick" />
        <MenuItem Header="Push..." InputGesture="Ctrl+Shift+P" Tag="push" Click="OnCommandClick" />
        <Separator />
        <MenuItem Header="Save Stash..." InputGesture="Ctrl+Shift+H" Tag="stash" Click="OnCommandClick" />
        <Separator />
        <MenuItem Header="New Branch..." InputGesture="Ctrl+Shift+B" Tag="branch" Click="OnCommandClick" />
        <MenuItem Header="New Tag..." InputGesture="Ctrl+Shift+G" Tag="tag" Click="OnCommandClick" />
        <MenuItem Header="New Worktree..." Tag="worktree" Click="OnCommandClick" />
        <Separator />
        <MenuItem Header="Open In File Explorer" InputGesture="Ctrl+Alt+O" Tag="fileExplorer" Click="OnCommandClick" />
        <MenuItem Header="{Binding TerminalName, Source={x:Static vm:AppPreferences.Current}, StringFormat='Open In {0}'}"
                  InputGesture="Ctrl+Alt+T" Tag="terminal" Click="OnCommandClick" />
        <Separator />
        <MenuItem Header="Settings for This Repository..." Tag="repositorySettings" Click="OnCommandClick" />
      </MenuItem>
      <!-- Window menu. Not built yet: Select Previous / Next Tab. -->
      <MenuItem Name="WindowMenu" Header="_Window">
        <MenuItem Header="Switch Theme" Click="OnSwitchThemeClick" />
        <Separator />
        <MenuItem Header="Zoom In" InputGesture="Ctrl+OemPlus" Click="OnZoomInClick" />
        <MenuItem Header="Zoom Out" InputGesture="Ctrl+OemMinus" Click="OnZoomOutClick" />
      </MenuItem>
      <!-- Help menu: the About dialog and the project's web pages. -->
      <MenuItem Name="HelpMenu" Header="_Help">
        <MenuItem Header="About GerGit" Click="OnAboutClick" />
        <Separator />
        <MenuItem Header="GitHub Page" Tag="{x:Static d:AboutViewModel.RepositoryUrl}" Click="OnWebPageClick" />
        <MenuItem Header="Report an Issue" Tag="{x:Static d:AboutViewModel.IssueUrl}" Click="OnWebPageClick" />
      </MenuItem>
    </Menu>

    <!-- Toolbar: left and right share the width, the status box column is 300 px. -->
    <Grid Name="Toolbar" DockPanel.Dock="Top" ColumnDefinitions="*,300,*" Background="{DynamicResource Color.Toolbar.Bg}">
      <StackPanel Name="ToolbarLeft" Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Name="QuickLaunchButton" Classes="toolbar" Margin="8,3,0,3" Click="OnQuickLaunchClick" ToolTip.Tip="Quick Launch">
          <StackPanel><c:LucideIcon Icon="search" Size="20" /><TextBlock Classes="caption" Text="Quick Launch" /></StackPanel>
        </Button>
        <Button Name="FetchButton" Classes="toolbar" Margin="16,3,0,3" IsEnabled="{Binding SelectedTab, Converter={x:Static ObjectConverters.IsNotNull}}" Tag="fetch" Click="OnToolbarClick"
                ToolTip.Tip="Fetch&#10;Hold Ctrl for Quick Fetch">
          <StackPanel><c:LucideIcon Icon="arrow-down-to-line" Size="20" /><TextBlock Classes="caption" Text="Fetch" /></StackPanel>
        </Button>
        <Panel>
          <Button Name="PullButton" Classes="toolbar" Margin="0,3,0,3" IsEnabled="{Binding SelectedTab, Converter={x:Static ObjectConverters.IsNotNull}}" Tag="pull" Click="OnToolbarClick"
                  ToolTip.Tip="Pull&#10;Hold Ctrl for Quick Pull">
            <StackPanel><c:LucideIcon Icon="arrow-down" Size="20" /><TextBlock Classes="caption" Text="Pull" /></StackPanel>
          </Button>
          <Canvas Name="PullBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                  IsVisible="{Binding SelectedTab.PullBadge, FallbackValue=False, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border Classes="badge" Canvas.Left="-10" Canvas.Top="1">
              <TextBlock Text="{Binding SelectedTab.PullBadge}" />
            </Border>
          </Canvas>
        </Panel>
        <Panel>
          <Button Name="PushButton" Classes="toolbar" Margin="0,3,0,3" IsEnabled="{Binding SelectedTab, Converter={x:Static ObjectConverters.IsNotNull}}" Tag="push" Click="OnToolbarClick"
                  ToolTip.Tip="Push&#10;Hold Ctrl for Quick Push">
            <StackPanel><c:LucideIcon Icon="arrow-up" Size="20" /><TextBlock Classes="caption" Text="Push" /></StackPanel>
          </Button>
          <Canvas Name="PushBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                  IsVisible="{Binding SelectedTab.PushBadge, FallbackValue=False, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border Classes="badge" Canvas.Left="-10" Canvas.Top="1">
              <TextBlock Text="{Binding SelectedTab.PushBadge}" />
            </Border>
          </Canvas>
        </Panel>
        <StackPanel Orientation="Horizontal" Margin="20,3,0,3">
          <Button Name="StashButton" Classes="toolbar" Padding="4,0" CornerRadius="3,0,0,3" IsEnabled="{Binding SelectedTab, Converter={x:Static ObjectConverters.IsNotNull}}" Tag="stash" Click="OnToolbarClick"
                  ToolTip.Tip="Stash">
            <StackPanel><c:LucideIcon Icon="archive" Size="20" /><TextBlock Classes="caption" Text="Stash" /></StackPanel>
          </Button>
          <Button Name="StashArrow" Classes="toolbar-arrow" IsEnabled="{Binding SelectedTab, Converter={x:Static ObjectConverters.IsNotNull}}" Click="OnStashArrowClick">
            <c:LucideIcon Icon="chevron-down" Size="12" />
          </Button>
        </StackPanel>
      </StackPanel>

      <!-- Status box: repository title and branch, or the primary job with spinner, progress
           and cancel; the list button and a click on the texts open the Activity Manager.
           Not built yet: branch filter button (the filter comes with the sidebar filter). -->
      <Border Name="StatusBox" Grid.Column="1" Height="36" Margin="0,0,0,3" VerticalAlignment="Bottom" CornerRadius="3"
              ClipToBounds="True" Background="{DynamicResource Color.Statusbar.Bg}">
        <Grid RowDefinitions="18,16,2" ColumnDefinitions="20,*,20">
          <DockPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="Transparent"
                     PointerPressed="OnStatusTextPressed">
            <c:BusySpinner Name="StatusSpinner" DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,4,0"
                       Foreground="{DynamicResource Color.Spinner.Color}" IsVisible="{Binding StatusBox.IsBusy}" />
            <Panel>
              <TextBlock Name="StatusTitle" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding !StatusBox.HasJob}"
                         Text="{Binding SelectedTab.Title, FallbackValue='Welcome to GerGit!', TargetNullValue='Welcome to GerGit!'}" />
              <TextBlock Name="JobTitle" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding StatusBox.HasJob}" Text="{Binding StatusBox.JobTitle}" />
            </Panel>
          </DockPanel>
          <Panel Grid.Row="1" Grid.Column="1" Background="Transparent" PointerPressed="OnStatusTextPressed">
            <!-- A DockPanel (not a horizontal StackPanel) gives the text a finite width, so a long branch name is
                 trimmed with an ellipsis inside the box; the tooltip shows the full name. -->
            <DockPanel HorizontalAlignment="Center" IsVisible="{Binding !StatusBox.HasJob}">
              <c:LucideIcon DockPanel.Dock="Left" Icon="git-branch" Size="12" VerticalAlignment="Center" Margin="0,0,3,0"
                            IsVisible="{Binding SelectedTab.ActiveBranchName, FallbackValue=False, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Name="StatusDescription" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         c:TrimmedToolTip.IsEnabled="True"
                         Text="{Binding SelectedTab.StatusDescription, FallbackValue='Open a repository to start', TargetNullValue='Open a repository to start'}" />
            </DockPanel>
            <TextBlock Name="JobDescription" FontSize="12" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                       VerticalAlignment="Center" IsVisible="{Binding StatusBox.HasJob}" Text="{Binding StatusBox.JobDescription}" />
          </Panel>
          <Button Name="ActivityButton" Grid.Row="1" Classes="icon" Width="16" Height="16" ToolTip.Tip="Activity Manager"
                  IsEnabled="{Binding !Activity.IsOpen}" Click="OnActivityClick">
            <c:LucideIcon Icon="list" Size="12" />
          </Button>
          <Button Name="JobCancelButton" Grid.Column="2" Grid.RowSpan="2" Classes="icon" Width="16" Height="16"
                  IsVisible="{Binding StatusBox.CanCancel}" Command="{Binding StatusBox.CancelCommand}">
            <c:LucideIcon Icon="x" Size="12" />
          </Button>
          <ProgressBar Name="JobProgress" Grid.Row="2" Grid.ColumnSpan="3" Height="2" MinHeight="2" Minimum="0" Maximum="100"
                       Value="{Binding StatusBox.ProgressValue}" IsVisible="{Binding StatusBox.HasProgress}" />
          <Popup Name="ActivityPopup" PlacementTarget="{Binding #StatusBox}" Placement="Bottom" IsLightDismissEnabled="True"
                 IsOpen="{Binding Activity.IsOpen, Mode=TwoWay}">
            <v:ActivityPopup DataContext="{Binding Activity}" />
          </Popup>
        </Grid>
      </Border>

      <Grid Name="ToolbarRight" Grid.Column="2" ColumnDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Margin="10,3,0,3">
          <Button Name="BranchButton" Classes="toolbar" Padding="4,0" CornerRadius="3,0,0,3" IsEnabled="{Binding SelectedTab, Converter={x:Static ObjectConverters.IsNotNull}}" Tag="branch" Click="OnToolbarClick"
                  ToolTip.Tip="Branch">
            <StackPanel><c:LucideIcon Icon="git-branch" Size="20" /><TextBlock Classes="caption" Text="Branch" /></StackPanel>
          </Button>
          <Button Name="BranchArrow" Classes="toolbar-arrow" IsEnabled="{Binding SelectedTab, Converter={x:Static ObjectConverters.IsNotNull}}" Click="OnBranchArrowClick">
            <c:LucideIcon Icon="chevron-down" Size="12" />
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Name="OpenInButton" Classes="toolbar" Margin="4,3,4,3" IsEnabled="{Binding SelectedTab, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Click="OnOpenInClick" ToolTip.Tip="Open in">
            <StackPanel><c:LucideIcon Icon="external-link" Size="20" /><TextBlock Classes="caption" Text="Open in" /></StackPanel>
          </Button>
          <!-- Console button: caption and tooltip = the configured terminal's name. -->
          <Button Name="TerminalButton" Classes="toolbar" Margin="0,3,0,3" IsEnabled="{Binding SelectedTab, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Tag="terminal" Click="OnToolbarClick" ToolTip.Tip="{Binding TerminalName, Source={x:Static vm:AppPreferences.Current}}">
            <StackPanel><c:LucideIcon Icon="terminal" Size="20" />
              <TextBlock Classes="caption" Text="{Binding TerminalName, Source={x:Static vm:AppPreferences.Current}}" /></StackPanel>
          </Button>
          <Button Name="AppearanceButton" Classes="toolbar" Margin="0,3,0,3" Click="OnAppearanceClick" ToolTip.Tip="Appearance">
            <StackPanel><c:LucideIcon Icon="sun-moon" Size="20" /><TextBlock Classes="caption" Text="Appearance" /></StackPanel>
          </Button>
          <!-- Workspaces button: caption = last "/" part of the active workspace; Ctrl+click = next workspace. -->
          <Button Name="WorkspacesButton" Classes="toolbar" Margin="0,3,4,3" Click="OnWorkspacesClick" ToolTip.Tip="Workspaces">
            <StackPanel><c:LucideIcon Icon="layers" Size="20" /><TextBlock Classes="caption" Text="{Binding WorkspaceCaption}" /></StackPanel>
          </Button>
          <!-- Notifications popup bell; at the toolbar's right end (no custom title bar). -->
          <Panel Name="NotificationsBell" Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="{Binding Notifications.IsAvailable}">
            <Button Name="NotificationsButton" Classes="icon" Width="24" Height="24" ToolTip.Tip="Notifications"
                    IsEnabled="{Binding !Notifications.IsOpen}" Command="{Binding Notifications.OpenCommand}">
              <c:LucideIcon Icon="bell" Size="16" />
            </Button>
            <Canvas Name="NotificationsBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                    IsVisible="{Binding Notifications.Badge, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Border Classes="badge" Canvas.Left="-10" Canvas.Top="-4">
                <TextBlock Text="{Binding Notifications.Badge}" />
              </Border>
            </Canvas>
            <Popup Name="NotificationsPopup" PlacementTarget="{Binding #NotificationsButton}" Placement="BottomEdgeAlignedRight"
                   VerticalOffset="3" IsLightDismissEnabled="True" IsOpen="{Binding Notifications.IsOpen, Mode=TwoWay}">
              <v:NotificationsPopup DataContext="{Binding Notifications}" />
            </Popup>
          </Panel>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Tab strip: equal-width tabs, then a 24 px column with the "+" button. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,24" Height="24" Background="{DynamicResource Color.Toolbar.Bg}">
      <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Color.Repotab.TopBorder}" Grid.ColumnSpan="2" />
      <ListBox Name="TabStrip" Classes="tabs" ItemsSource="{Binding StripTabs}" SelectedItem="{Binding SelectedStripTab}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.DataTemplates>
          <DataTemplate x:DataType="vm:RepoTabViewModel">
            <Grid ColumnDefinitions="18,*,18" Background="Transparent" ToolTip.Tip="{Binding Path}"
                  PointerReleased="OnTabPointerReleased">
              <TextBlock Grid.Column="1" Text="{Binding Title}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="2" Classes="tabclose" VerticalAlignment="Center"
                      IsVisible="{Binding $parent[ListBoxItem].IsPointerOver}"
                      Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                      CommandParameter="{Binding}">
                <c:LucideIcon Icon="x" Size="10" />
              </Button>
            </Grid>
          </DataTemplate>
          <!-- Tab kinds: the Repository Manager tab (no tooltip). -->
          <DataTemplate x:DataType="vm:RepositoryManagerViewModel">
            <Grid ColumnDefinitions="18,*,18" Background="Transparent" PointerReleased="OnTabPointerReleased">
              <TextBlock Grid.Column="1" Text="Repository Manager" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="2" Classes="tabclose" VerticalAlignment="Center"
                      IsVisible="{Binding $parent[ListBoxItem].IsPointerOver}" Click="OnManagerCloseClick">
                <c:LucideIcon Icon="x" Size="10" />
              </Button>
            </Grid>
          </DataTemplate>
        </ListBox.DataTemplates>
      </ListBox>
      <Button Grid.Column="1" Classes="icon" Margin="2,1,1,1" Click="OnNewTabClick" ToolTip.Tip="New Tab">
        <c:LucideIcon Icon="plus" Size="14" />
      </Button>
    </Grid>

    <Panel>
      <!-- One view per tab; only the selected one is visible, so splitter positions survive tab switches. -->
      <ItemsControl ItemsSource="{Binding Tabs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><Panel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RepoTabViewModel">
            <v:RepoTabView IsVisible="{Binding IsActive}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Repository Manager (start screen): the content of the Repository Manager tab. -->
      <Panel IsVisible="{Binding IsManagerShown}">
        <v:RepositoryManagerView Name="ManagerView" DataContext="{Binding Manager}" />
      </Panel>
    </Panel>
  </DockPanel>
</Window>
