<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GerGit.ViewModels.Dialogs"
             x:Class="GerGit.Views.Dialogs.CredentialsView"
             x:DataType="vm:CredentialsViewModel">
  <Grid ColumnDefinitions="Auto,*">
    <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" />
    <TextBox Name="Input" Grid.Column="1" Margin="8,0,0,0" Text="{Binding Text}" />
  </Grid>
</UserControl>
