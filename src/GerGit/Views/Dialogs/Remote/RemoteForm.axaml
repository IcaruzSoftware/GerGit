<!-- Form layout of the remote dialogs: right-aligned 13 px labels, 8 px gap, rows 4 px apart. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Grid.form">
    <Setter Property="ColumnSpacing" Value="8" />
    <Setter Property="RowSpacing" Value="4" />
  </Style>
  <Style Selector="Grid.form > TextBlock.label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Grid.form > ComboBox">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
</Styles>
