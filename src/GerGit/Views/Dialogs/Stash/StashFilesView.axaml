<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GerGit.ViewModels.Dialogs"
             xmlns:c="using:GerGit.Controls"
             x:Class="GerGit.Views.Dialogs.StashFilesView"
             x:DataType="vm:StashFilesViewModel">
  <!-- Stash Files / Save stash (partial stash): message, then every changed file with a check box. -->
  <Grid RowDefinitions="Auto,*">
    <TextBox Name="MessageBox" Text="{Binding Message}" PlaceholderText="Stash message (optional)">
      <TextBox.InnerLeftContent><c:LucideIcon Icon="archive" Size="14" Margin="6,0,0,0" VerticalAlignment="Center" /></TextBox.InnerLeftContent>
    </TextBox>
    <Border Grid.Row="1" Margin="0,8,0,0" BorderThickness="1" BorderBrush="{DynamicResource Color.Border.Default}"
            Background="{DynamicResource Color.List.Bg}">
      <ScrollViewer>
        <ItemsControl Name="FileList" ItemsSource="{Binding Files}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StashFileRow">
              <CheckBox Margin="6,0" IsChecked="{Binding IsChecked}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:LucideIcon Icon="{Binding Icon}" Size="16" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Path}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
