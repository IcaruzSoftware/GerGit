<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:GerGit.Controls">
  <!-- Form rows of the ref dialogs: 13 px labels, right-aligned, 8 px to the control, rows 4 px apart. -->
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Grid.form">
    <Setter Property="ColumnSpacing" Value="8" />
    <Setter Property="RowSpacing" Value="4" />
  </Style>
  <Style Selector="c|LucideIcon.warning">
    <Setter Property="Icon" Value="triangle-alert" />
    <Setter Property="Size" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Color.Status.Warning}" />
  </Style>
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
