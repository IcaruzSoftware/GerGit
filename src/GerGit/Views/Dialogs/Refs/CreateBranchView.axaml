<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GerGit.ViewModels.Dialogs.Refs"
             xmlns:r="using:GerGit.Views.Dialogs.Refs"
             xmlns:c="using:GerGit.Controls"
             x:Class="GerGit.Views.Dialogs.Refs.CreateBranchView"
             x:DataType="vm:CreateBranchViewModel">
  <UserControl.Styles><StyleInclude Source="avares://GerGit/Views/Dialogs/Refs/RefStyles.axaml" /></UserControl.Styles>
  <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
    <TextBlock Classes="label" Text="Create branch at:" />
    <c:RefView Name="Start" Grid.Column="1" Icon="{Binding Start.Icon}" Text="{Binding Start.Text}" Detail="{Binding Start.Detail}" />
    <TextBlock Grid.Row="1" Classes="label" Text="Branch name:" />
    <c:RefNameBox Name="NameBox" Grid.Row="1" Grid.Column="1" Icon="git-branch" Text="{Binding Name}" PlaceholderText="Enter branch name" />
    <CheckBox Name="CheckoutBox" Grid.Row="2" Grid.Column="1" Content="Check out after create" IsChecked="{Binding CheckoutAfterCreate}" />
    <TextBlock Grid.Row="3" Classes="label" Text="Local changes:" IsVisible="{Binding Local.IsVisible}" />
    <r:LocalChangesBlockView Name="LocalBlock" Grid.Row="3" Grid.Column="1" DataContext="{Binding Local}" />
  </Grid>
</UserControl>
