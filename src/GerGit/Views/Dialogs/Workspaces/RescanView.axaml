<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GerGit.ViewModels.Dialogs"
             x:Class="GerGit.Views.Dialogs.RescanView"
             x:DataType="vm:RescanViewModel">
  <!-- Rescan Repositories. -->
  <CheckBox Name="ResetBox" Content="Reset previously deleted repository entries" IsChecked="{Binding Reset}" />
</UserControl>
