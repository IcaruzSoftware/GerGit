<!--
  GerGit colour tokens and fonts, dark and light (switching: Views/AppTheme.cs).

  Naming: every design token becomes a SolidColorBrush keyed "Color." + the token, each
  dot-separated part in PascalCase:  text.primary -> Color.Text.Primary,
  tree-row.bg-selected-inactive -> Color.TreeRow.BgSelectedInactive. "@NN% alpha" is folded into ARGB.
  repotab.shadow-opacity is folded into the selected repo tab's shadow (Color.Repotab.Shadow, a BoxShadows: black at 0.8 / 0.30).
  Palettes: Color.Lane.<0-12>, Color.RefLabel.Border.<0-12>, Color.RefLabel.Fill.<0-12>,
  Color.Repo.<Name>, Color.FileStatus.<Kind>, Color.Status.<Warning|Error|Success>, Color.Diff.<Part>,
  Color.Merge.<Part>, Color.Syntax.<Class>. Fonts: Font.UI, Font.Mono.

  Values that differ per theme live in the "Dark" and "Light" theme dictionaries below, with the same keys in both
  (a test checks that). Always reference them with DynamicResource so a theme switch re-colours everything; code that
  looks one up must look it up again when ActualThemeVariant changes.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Linux mapping. Limitation: the desktop UI font is not read; Inter (bundled) comes first. -->
  <FontFamily x:Key="Font.UI">fonts:Inter#Inter, Noto Sans, sans-serif</FontFamily>
  <FontFamily x:Key="Font.Mono">JetBrains Mono, DejaVu Sans Mono, Liberation Mono, monospace</FontFamily>

  <!-- lane colours (both themes) -->
  <SolidColorBrush x:Key="Color.Lane.0" Color="#FF9502" />
  <SolidColorBrush x:Key="Color.Lane.1" Color="#FFCC00" />
  <SolidColorBrush x:Key="Color.Lane.2" Color="#FF3B30" />
  <SolidColorBrush x:Key="Color.Lane.3" Color="#A2845E" />
  <SolidColorBrush x:Key="Color.Lane.4" Color="#64DA38" />
  <SolidColorBrush x:Key="Color.Lane.5" Color="#1CADF8" />
  <SolidColorBrush x:Key="Color.Lane.6" Color="#CB73E1" />
  <SolidColorBrush x:Key="Color.Lane.7" Color="#8E8E91" />
  <SolidColorBrush x:Key="Color.Lane.8" Color="#FF2968" />
  <SolidColorBrush x:Key="Color.Lane.9" Color="#30D5C8" />
  <SolidColorBrush x:Key="Color.Lane.10" Color="#5856D6" />
  <SolidColorBrush x:Key="Color.Lane.11" Color="#B4D435" />
  <SolidColorBrush x:Key="Color.Lane.12" Color="#FF6F61" />
  <SolidColorBrush x:Key="Color.Graph.HoverOutline" Color="#0092FF" />

  <!-- merge editor line-number gutter (both themes) -->
  <SolidColorBrush x:Key="Color.Merge.LineNumber" Color="#C0C0C0" />
  <SolidColorBrush x:Key="Color.Merge.SelectedTag" Color="#3B89DA" />

  <!-- repository colours -->
  <SolidColorBrush x:Key="Color.Repo.Red" Color="#FF3B30" />
  <SolidColorBrush x:Key="Color.Repo.Orange" Color="#FF9502" />
  <SolidColorBrush x:Key="Color.Repo.Yellow" Color="#FFCC00" />
  <SolidColorBrush x:Key="Color.Repo.Green" Color="#64DA38" />
  <SolidColorBrush x:Key="Color.Repo.Blue" Color="#1CADF8" />
  <SolidColorBrush x:Key="Color.Repo.Violet" Color="#CB73E1" />

  <!-- file status badges and status icons (both themes) -->
  <SolidColorBrush x:Key="Color.FileStatus.Added" Color="#28CD41" />
  <SolidColorBrush x:Key="Color.FileStatus.Modified" Color="#FFCC00" />
  <SolidColorBrush x:Key="Color.FileStatus.Deleted" Color="#FF453A" />
  <SolidColorBrush x:Key="Color.FileStatus.Renamed" Color="#BF5AF2" />
  <SolidColorBrush x:Key="Color.FileStatus.Copied" Color="#AF52DE" />
  <SolidColorBrush x:Key="Color.FileStatus.Conflict" Color="#FFCC20" />
  <SolidColorBrush x:Key="Color.Status.Warning" Color="#FFCC20" />
  <SolidColorBrush x:Key="Color.Status.Error" Color="#E51400" />
  <SolidColorBrush x:Key="Color.Status.Success" Color="#36CF4A" />

  <ResourceDictionary.ThemeDictionaries>
