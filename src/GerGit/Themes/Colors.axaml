      <DrawingBrush x:Key="ImageDiff.Checker" TileMode="Tile" DestinationRect="0,0,16,16">
        <DrawingBrush.Drawing>
          <DrawingGroup>
            <DrawingGroup.Children>
              <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H16 V16 H0 Z" />
              <GeometryDrawing Brush="#D6D6D6" Geometry="M8,0 H16 V8 H8 Z M0,8 H8 V16 H0 Z" />
            </DrawingGroup.Children>
