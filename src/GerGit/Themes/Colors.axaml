      <!-- checkerboard behind images, a 16 px tile of four 8 px squares. -->
      <DrawingBrush x:Key="ImageDiff.Checker" TileMode="Tile" DestinationRect="0,0,16,16">
        <DrawingBrush.Drawing>
          <DrawingGroup>
            <DrawingGroup.Children>
              <GeometryDrawing Brush="#CECECE" Geometry="M0,0 H16 V16 H0 Z" />
