# Maintainer: Gerrit Visser <developericaruz at gmail dot com>
pkgname=gergit-bin
pkgver=1.0.2
pkgrel=1
pkgdesc='Git client for Linux'
arch=(x86_64)
url=https://github.com/IcaruzSoftware/GerGit
license=('GPL-3.0-or-later' 'MIT' 'ISC' 'OFL-1.1' 'CC0-1.0')
# git plus the libraries the app loads at runtime (dlopen/P/Invoke, so namcap cannot see most of them); ttf-font: Avalonia needs a system font.
depends=(git glibc libgcc libstdc++ icu openssl fontconfig ttf-font libx11 libxext libxi libxrandr libxcursor libxfixes libice
         libsm libsecret glib2 hicolor-icon-theme)
optdepends=('libnotify: desktop notifications'
            'xdg-utils: opening folders and links')
provides=(gergit)
conflicts=(gergit)
# Stripping breaks the .NET single-file bundle.
options=(!strip !debug)
source=("https://github.com/IcaruzSoftware/GerGit/releases/download/v$pkgver/gergit-$pkgver-linux-x64.tar.gz")
# Replace with the published asset's checksum (updpkgsums) before pushing to the AUR.
sha256sums=('SKIP')

package() {
  cd "gergit-$pkgver-linux-x64"
  install -d "$pkgdir/opt" "$pkgdir/usr/bin"
  cp -r --no-preserve=ownership . "$pkgdir/opt/gergit"
  ln -s /opt/gergit/GerGit "$pkgdir/usr/bin/gergit"
  install -Dm644 gergit.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 gergit.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 gergit.png -t "$pkgdir/usr/share/icons/hicolor/256x256/apps"
  install -Dm644 LICENSE THIRD-PARTY-NOTICES.md OFL-1.1.txt Assets/LUCIDE-LICENSE.txt Assets/SIMPLE-ICONS-LICENSE.txt \
    -t "$pkgdir/usr/share/licenses/$pkgname"
}
