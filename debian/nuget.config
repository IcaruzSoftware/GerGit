<?xml version="1.0" encoding="utf-8"?>
<!-- Offline restore: only the vendored packages (orig-nuget component, unpacked to nuget/) and the SDK's own
     library-packs (Microsoft.NET.ILLink.Tasks). Relative paths are relative to this file. -->
<configuration>
  <packageSources>
    <clear />
    <add key="vendored" value="../nuget" />
    <add key="sdk-library-packs" value="/usr/lib/dotnet/library-packs" />
  </packageSources>
</configuration>
